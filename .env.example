# Copy to .env and fill in as needed. .env is gitignored — never commit real secrets.
# Model endpoints and protocol profiles belong in common/config/models.yaml.
# Only secret keys referenced by *_env fields belong here:
# LLM_CHAT_API_KEY=your-secret
# LLM_EMBED_API_KEY=your-secret
# LLM_RERANK_AUTH_APP_KEY=your-app-key
# LLM_RERANK_AUTH_APP_SECRET=your-app-secret
# LLM_RERANK_AUTH_AUTHORIZATION=Bearer your-token
# LLM_CONFIG_HOST_FILE=/absolute/shared/models.yaml
#
# Docker Compose loads this file into the container and mounts models.yaml.
# A2AT_* configures the separate A2A-T SDK and is not inferred from LLM settings.

# ============================================================
# Docker Compose — etc/conf/server.conf overrides (optional; defaults shown)
# ============================================================
# ORCH_IP=0.0.0.0
# ORCH_PORT=5001
# ORCH_ENABLE_HTTPS=false
# ORCH_FORWARDED_ALLOW_IPS=*
# PERSISTENCE_MODE=file
# AGENT_REGISTRY_URL=https://openan-registry-center:5000

# ============================================================
# Docker Compose — optional PostgreSQL persistence (docker-compose.yml).
# Only read when PERSISTENCE_MODE=postgresql.
# ============================================================
# DB_HOST=postgres
# DB_PORT=5432
# DB_NAME=orchestration_center
# DB_USERNAME=
# DB_PASSWORD=

# ============================================================
# A2A-T SDK Configuration (independent of LLM_* settings)
# ============================================================

# Prompt runtime
A2AT_LANGUAGE=zh-CN
A2AT_PROMPT_SOURCE_TYPE=packaged
A2AT_PROMPT_RESOURCE_LOCAL_ROOT_DIR=

# Prompt compliance
A2AT_PROMPT_COMPLIANCE_ENABLED=false
A2AT_PROMPT_COMPLIANCE_GUARDRAIL_PROVIDER=noop

# LLM runtime — required for PSOP generation/execution and negotiation to
# actually succeed; leave A2AT_LLM_API_KEY blank and calls will fail auth.
# Keep A2AT_LLM_PROVIDER=openai. It selects the A2A-T SDK client, not the model
# vendor (the endpoint is whatever A2AT_LLM_BASE_URL points at). The SDK
# registers `openai` in every process; other names are rejected by the sample
# agents with "Unknown llm provider" unless that process registers them itself
# (`orchestrate.runtime.exec_engine` registers `deepseek` inside the backend
# only), so `openai` is the only value that works for the whole stack.
A2AT_LLM_PROVIDER=openai
A2AT_LLM_MODEL=deepseek-chat
A2AT_LLM_API_KEY=
A2AT_LLM_BASE_URL=https://api.deepseek.com
A2AT_LLM_MAX_TOKENS=2000
A2AT_LLM_TEMPERATURE=0
A2AT_LLM_TIMEOUT_SECONDS=60
A2AT_LLM_HISTORY_WINDOW=10
A2AT_LLM_SESSION_MAX_TOTAL=300
A2AT_LLM_SESSION_MAX_PER_PROVIDER=100
